# Copia este archivo a .env.local y completa los valores de tu proyecto Supabase.
# NUNCA subas .env.local al repositorio.

# Público (puede estar en el navegador)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publica-anon

# Solo servidor: NO prefijar con NEXT_PUBLIC_. Usar solo para scripts de arranque.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-de-servicio

# URL pública de la aplicación (enlaces de recuperación de contraseña)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
